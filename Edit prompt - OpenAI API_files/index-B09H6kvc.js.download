on:"Warning on the Platform Trusted Access page when a background status refresh fails. The previous status and local application answers remain visible, but final submission is disabled until a refresh succeeds."},pageTitle:{id:"platform.trusted_access.page.trusted_access.title",defaultMessage:"Trusted Access",description:"Page and navigation title in Platform organization settings for Trusted Access. The page combines business verification with a scalable directory of specialized trusted-access programs. Short heading."},pageSubtitle:{id:"platform.trusted_access.page.trusted_access.subtitle",defaultMessage:"Verify your business and apply for specialized access for your workspace.",description:"Subtitle under the Trusted Access page title in Platform organization settings. It tells an eligible organization administrator that they can verify their business and review applications for specialized access programs."},loading:{id:"platform.trusted_access.loading",defaultMessage:"Loading organization statuses…",description:"Loading-state text on the Status & access page in Platform organization settings while organization-level program status is being fetched. It must not imply that access is active or inactive."},unavailableTitle:{id:"platform.trusted_access.error.title",defaultMessage:"Organization statuses are temporarily unavailable",description:"Error-state heading on the Status & access page in Platform organization settings when organization-level program status could not be loaded. It must not imply that the organization has no access."},unavailableDescription:{id:"platform.trusted_access.error.description",defaultMessage:"We couldn't load this organization's status. Try again.",description:"Supporting error text on the Status & access page in Platform organization settings when the organization-level status request fails. It asks the owner or admin to retry without making any access claim."},retry:{id:"platform.trusted_access.error.retry",defaultMessage:"Try again",description:"Short button label in the error state on the Status & access admin page. Selecting it retries the organization-level status request."},businessVerificationStartError:{id:"platform.trusted_access.business_verification.start.error",defaultMessage:"We couldn't start business verification. Try again.",description:"Error notification shown to a Platform organization administrator when starting or continuing the real Persona organization verification required for Trusted Access for Cyber fails. It asks the administrator to retry without claiming that verification was completed."},programTabsLabel:{id:"platform.trusted_access.tabs.label",defaultMessage:"Trusted access programs",description:"Accessible label for the compact TAC and upcoming TAB program tabs on the Trusted Access organization settings page."},cyberTab:{id:"platform.trusted_access.tabs.cyber",defaultMessage:"Daybreak Blue",description:"Short tab label for the Daybreak Blue program in workspace administration. Use the full Daybreak Blue brand name."},cyberApplicationDescription:{id:"platform.trusted_access.application.cyber.description",defaultMessage:"Complete the steps below to apply for cyber trusted access.",description:"Supporting sentence below the Trusted Access for Cyber heading on the tab-based organization settings application page."},cyberApplicationRejectedDescription:{id:"platform.trusted_access.application.cyber.rejected_description",defaultMessage:"Your Daybreak Blue application was not approved.",description:"Program header description when the current application was rejected; does not invite the organization to apply again."},applicationUpdates:{id:"platform.trusted_access.application.updates",defaultMessage:"We’ll email the application contact and your organization when your verification or application status changes.",description:"Reassuring note beneath the Trusted Access for Cyber application checklist explaining that the application contact and organization receive status updates by email."},applicationTitle:{id:"platform.trusted_access.application.title",defaultMessage:"Application requirements",description:"Heading above the numbered application checklist inside an expanded trusted-access program on the organization settings Trusted Access page."},formStepTitle:{id:"platform.trusted_access.application.step.form.title",defaultMessage:"Complete form",description:"Title of the first numbered application-checklist step for Trusted Access for Cyber on the organization settings Trusted Access page."},formStepDescription:{id:"platform.trusted_access.application.step.form.description",defaultMessage:"Tell us about your organization and intended use.",description:"Supporting text beneath the first numbered application-checklist step for Trusted Access for Cyber. It explains that the existing request form collects organization and intended-use information."},termsStepTitle:{id:"platform.trusted_access.application.step.terms.title",defaultMessage:"Daybreak - Business Terms",description:"Title of the second numbered application-checklist step and the legal-signature panel for the Daybreak program on the organization settings Trusted Access page. Preserve the spaced hyphen and title casing."},termsStepDescription:{id:"platform.trusted_access.application.step.terms.description",defaultMessage:"Review and accept the Daybreak Blue terms.",description:"Supporting text beneath the legal-terms checklist step for Daybreak Blue. It describes reviewing and accepting the specialized access program terms."},submitStepTitle:{id:"platform.trusted_access.application.step.submit.title",defaultMessage:"Submit application",description:"Title of the final numbered application-checklist step for Trusted Access for Cyber on the organization settings Trusted Access page."},submitStepDescription:{id:"platform.trusted_access.application.step.submit.description",defaultMessage:"We’ll run eligibility checks and keep your status up to date.",description:"Supporting text beneath the final application-checklist step for Trusted Access for Cyber. It explains that submission becomes available only after the earlier requirements are complete."},completed:{id:"platform.trusted_access.application.step.status.completed",defaultMessage:"Completed",description:"Short green status label beside a finished numbered step in the Trusted Access for Cyber application checklist on the organization settings page."},editForm:{id:"platform.trusted_access.application.step.form.action.edit",defaultMessage:"Edit",description:"Short secondary button beside the completed organization-information step in the Trusted Access for Cyber application checklist. Selecting it reopens the existing multi-step request form."},reviewAndSign:{id:"platform.trusted_access.application.step.terms.action.sign",defaultMessage:"Review & sign",description:"Short primary button beside the legal-terms step in the Trusted Access for Cyber application checklist. Selecting it marks the simulated terms as signed and enables the final simulated submission step."},signed:{id:"platform.trusted_access.application.step.terms.action.signed",defaultMessage:"Signed",description:"Short disabled button label beside the legal-terms step after the workspace administrator has signed the simulated Trusted Access for Cyber terms."},signerPrintName:{id:"platform.trusted_access.application.terms.signer_print_name",defaultMessage:"Full name *",description:"Required field label in the Daybreak electronic-signature block for the person accepting the terms on behalf of the organization. The visible asterisk is part of the source form wording."},signerEmail:{id:"platform.trusted_access.application.terms.signer_email",defaultMessage:"Email address *",description:"Required field label in the Trusted Access for Cyber legal-terms step for the person accepting the terms on behalf of the organization."},signerDate:{id:"platform.trusted_access.application.terms.signer_date",defaultMessage:"Date *",description:"Label for the read-only date displayed when a user accepts Trusted Access for Cyber legal terms."},termsAcceptance:{id:"platform.trusted_access.application.terms.acceptance",defaultMessage:"I certify that:",description:"Required checkbox label in the Daybreak final-attestation section. The detailed certifications appear immediately below this short label."},signTerms:{id:"platform.trusted_access.application.terms.action.confirm",defaultMessage:"Accept and sign",description:"Full-width primary button that accepts the Daybreak business terms and records the user's electronic signature before final submission."},termsProgress:{id:"platform.trusted_access.application.terms.progress",defaultMessage:"STEP 2 OF 3",description:"Uppercase progress kicker at the top of the Daybreak business-terms panel. It tells an organization administrator that legal review is the second of three application stages."},termsDescription:{id:"platform.trusted_access.application.terms.description",defaultMessage:"Review the business terms and complete your electronic signature.",description:"Supporting sentence below the Daybreak business-terms title. It instructs an organization administrator to review the terms and sign electronically."},readFullTerms:{id:"platform.trusted_access.application.terms.read_full",defaultMessage:"Read full Daybreak Business Terms ↗",description:"Link label above the embedded Daybreak legal document. The arrow indicates that the full terms open in a new browser tab."},legalTermsHeading:{id:"platform.trusted_access.application.terms.legal.heading",defaultMessage:"Legal Terms",description:"Heading for the first section of the embedded Daybreak business-terms document shown to an organization administrator before signing."},legalTermsBody:{id:"platform.trusted_access.application.terms.legal.body",defaultMessage:"This Application intake form, the responses provided herein, and these legal terms (collectively, the “Intake Form”), form part of the agreement between OpenAI and the entity named in Section A above (“Customer”) for services (“Services Agreement”), and govern Customer’s access to models made available to you through Trusted Access for Cyber (“TAC”). If there is any conflict between this Intake Form and the Services Agreement, this Intake Form controls.",description:"First legal paragraph in the Daybreak business-terms document. This binding customer-facing text must remain verbatim, including capitalization, curly quotation marks, defined terms, and the TAC abbreviation."},representationsHeading:{id:"platform.trusted_access.application.terms.representations.heading",defaultMessage:"Representations and Warranties.",description:"Heading for the representations-and-warranties section of the Daybreak business-terms document. Preserve the ending period."},representationsBody:{id:"platform.trusted_access.application.terms.representations.body",defaultMessage:"Customer represents and warrants that the Intake Form is true and correct in all respects, and Customer will notify OpenAI if there are any material changes to the information submitted in the Intake Form during the term in which TAC is used. Customer acknowledges and agrees that provision of false or misleading information in the Intake Form, or any failure to notify OpenAI in writing if any information provided in the Intake Form has changed or is no longer complete and accurate, will constitute a material breach of the Agreement.",description:"Binding representations-and-warranties paragraph in the Daybreak business-terms document. This customer-facing legal text must remain verbatim."},approvedUseCaseHeading:{id:"platform.trusted_access.application.terms.approved_use_case.heading",defaultMessage:"Approved Use Case.",description:"Heading for the approved-use-case section of the Daybreak business-terms document. Preserve the ending period."},approvedUseCaseBody:{id:"platform.trusted_access.application.terms.approved_use_case.body",defaultMessage:"Participation in Trusted Access for Cyber comes with heightened responsibility. Access to advanced cyber capabilities is granted only for legitimate, defensive, and authorized security purposes (“Approved Use Cases”). Approved Use Cases are intended to enable real-world security testing, vulnerability research, and defensive readiness and do not include uses that may cause harm, disruption, or unauthorized access. You must only use TAC for the Approved Use Cases and in compliance with OpenAI’s usage policies at: https://openai.com/policies/usage-policies/, as well as OpenAI’s Cyber Abuse Policy below.",description:"Binding approved-use-case paragraph in the Daybreak business-terms document. This customer-facing legal text must remain verbatim, including the URL and curly quotation marks."},cyberAbusePolicyHeading:{id:"platform.trusted_access.application.terms.cyber_abuse_policy.heading",defaultMessage:"Cyber Abuse Policy:",description:"Heading for the cyber-abuse-policy section of the Daybreak business-terms document. Preserve the ending colon."},cyberAbusePolicyBody:{id:"platform.trusted_access.application.terms.cyber_abuse_policy.body",defaultMessage:"We disallow use of our services to facilitate cyber abuse: the compromise of the integrity, confidentiality, or availability of an information system—to include ‘dual-use’ cyber activities carried out with malicious intent, without proper authorization, or in excess of granted authorization.",description:"Binding cyber-abuse-policy paragraph in the Daybreak business-terms document. This customer-facing legal text must remain verbatim, including the em dash and curly single quotation marks."},approvedCredentialsHeading:{id:"platform.trusted_access.application.terms.approved_credentials.heading",defaultMessage:"Approved Access Credentials.",description:"Heading for the approved-access-credentials section of the Daybreak business-terms document. Preserve the ending period."},approvedCredentialsBody:{id:"platform.trusted_access.application.terms.approved_credentials.body",defaultMessage:"“Approved Access Credentials” are, collectively, the Org ID and specific end user IDs approved by OpenAI for any Approved Use Case. Customer is responsible for all activities that occur using the Approved Access Credentials. Customer may not share or otherwise make the Approved Access Credentials available to any entity or individual not disclosed on the Intake Form, or share or sell access to the capabilities provided under the Approved Access Credentials to third parties. Customer must immediately notify OpenAI if it becomes aware of or reasonably suspects unauthorized access or use of Approved Access Credentials, including any use of TAC for a purpose that is not an Approved Use Case.",description:"Binding approved-access-credentials paragraph in the Daybreak business-terms document. This customer-facing legal text must remain verbatim, including defined-term capitalization and curly quotation marks."},additionalActionsHeading:{id:"platform.trusted_access.application.terms.additional_actions.heading",defaultMessage:"Additional Actions.",description:"Heading for the additional-actions section of the Daybreak business-terms document. Preserve the ending period."},additionalActionsBody:{id:"platform.trusted_access.application.terms.additional_actions.body",defaultMessage:"OpenAI will have the right to take any action it deems necessary, in its sole discretion, to preserve the safety, security and integrity of the Services or its business, including, without limitation, suspending or terminating TAC without refund, requiring additional documentation or assurances to permit continued TAC, conditioning TAC use on Customer’s acceptance of additional requirements or limitations, and pursuing all legal and equitable remedies permitted by applicable laws.",description:"Binding additional-actions paragraph in the Daybreak business-terms document. This customer-facing legal text must remain verbatim."},indemnificationHeading:{id:"platform.trusted_access.application.terms.indemnification.heading",defaultMessage:"Indemnification.",description:"Heading for the indemnification section of the Daybreak business-terms document. Preserve the ending period."},indemnificationBody:{id:"platform.trusted_access.application.terms.indemnification.body",defaultMessage:"Notwithstanding anything to the contrary in the Services Agreement, Customer will indemnify, defend, and hold OpenAI and its affiliates harmless against any liabilities, damages, and costs (including reasonable attorneys’ fees) payable to a third party arising out of any use of the Approved Access Credentials in violation of this Intake Form. Limitations on liability in the Services Agreement do not apply to this Intake Form.",description:"Binding indemnification paragraph in the Daybreak business-terms document. This customer-facing legal text must remain verbatim, including the curly apostrophe."},finalAttestationHeading:{id:"platform.trusted_access.application.terms.final_attestation.heading",defaultMessage:"Final Attestation",description:"Heading above the required final certification in the Daybreak business-terms panel."},finalAttestationIntro:{id:"platform.trusted_access.application.terms.final_attestation.intro",defaultMessage:"By clicking “I certify” below and submitting this form, I confirm and certify:",description:"Instruction immediately above the final-attestation checkbox in the Daybreak business-terms panel. Preserve the curly quotation marks around I certify."},finalAttestationAccuracy:{id:"platform.trusted_access.application.terms.final_attestation.accuracy",defaultMessage:"I have reviewed the Intake Form and I declare and confirm that the information provided is accurate and complete to the best of my knowledge and belief after due inquiry and reasonable diligence.",description:"First binding certification below the Daybreak final-attestation checkbox. This customer-facing legal text must remain verbatim."},finalAttestationAuthority:{id:"platform.trusted_access.application.terms.final_attestation.authority",defaultMessage:"I have requisite authority to sign this form on behalf of the Customer and have obtained all internal approvals required to pursue TAC.",description:"Second binding certification below the Daybreak final-attestation checkbox. This customer-facing legal text must remain verbatim."},finalAttestationUpdates:{id:"platform.trusted_access.application.terms.final_attestation.updates",defaultMessage:"I will notify OpenAI in writing immediately if I learn that any information in this Intake Form is not, or is no longer, accurate and complete.",description:"Third binding certification below the Daybreak final-attestation checkbox. This customer-facing legal text must remain verbatim."},finalAttestationAgreement:{id:"platform.trusted_access.application.terms.final_attestation.agreement",defaultMessage:"Customer agrees to the legal terms in this Intake Form, which are hereby incorporated into the Service Agreement.",description:"Fourth binding certification below the Daybreak final-attestation checkbox. This customer-facing legal text must remain verbatim."},electronicSignatureHeading:{id:"platform.trusted_access.application.terms.signature.heading",defaultMessage:"Electronic signature",description:"Heading for the electronic-signature block in the Daybreak business-terms panel."},electronicSignatureIntro:{id:"platform.trusted_access.application.terms.signature.intro",defaultMessage:"Complete the signature below to accept these terms on behalf of {legalEntityName}.",description:"Instruction in the Daybreak electronic-signature block. The legalEntityName placeholder is the applying organization's legal name and is always non-empty because it comes from the completed intake form."},signatureResponsibility:{id:"platform.trusted_access.application.terms.signature.responsibility",defaultMessage:"By signing, I confirm that I am authorized to sign on behalf of {legalEntityName} and take responsibility for the accuracy and completeness of this entire application.",description:"Binding confirmation below the Daybreak electronic-signature fields. The legalEntityName placeholder is the applying organization's legal name and is always non-empty."},signatureNote:{id:"platform.trusted_access.application.terms.signature.note",defaultMessage:"Your full name serves as your electronic signature.",description:"Centered helper text below the Daybreak Accept and sign button explaining the legal effect of the full-name field."},submissionError:{id:"platform.trusted_access.application.submit.error",defaultMessage:"We couldn't submit your application. Please try again.",description:"Inline error shown when final Trusted Access for Cyber application submission fails."},submitted:{id:"platform.trusted_access.application.status.submitted",defaultMessage:"Application submitted",description:"Success status label shown after the Trusted Access for Cyber application submission request succeeds."},verificationRequired:{id:"platform.trusted_access.application.verification_required",defaultMessage:"Complete business verification above to start your application.",description:"Informational notice above the Trusted Access for Cyber application checklist when simulated business verification is incomplete. It explains why application actions are disabled."},requestAccess:{id:"platform.trusted_access.requestable.action",defaultMessage:"Request access",description:"Primary button that opens the inline Trusted Access for Cyber application form from the Status & access organization settings page."},trustedAccessTitle:{id:"platform.trusted_access.trusted_access.title",defaultMessage:"Daybreak Blue",description:"Formal program name shown in both the status selector and detail panel on the Status & access page in Platform organization settings. It identifies the organization's Daybreak Blue program and should remain concise."},trustedAccessListDescription:{id:"platform.trusted_access.trusted_access.list_description",defaultMessage:"Cyber safeguards and access",description:"Compact secondary label for Trusted Access for Cyber in the status selector on the Status & access admin page. It distinguishes this program from other future organization statuses. Short phrase with no punctuation."},trustedAccessActiveDescription:{id:"platform.trusted_access.trusted_access.description.active",defaultMessage:"Your organization has Daybreak Blue. The access level below applies through the organization's approval.",description:"Body text in the Daybreak Blue detail panel when the organization's status is active. It reassures an organization administrator that access is effective and clarifies that it comes from organization approval rather than an individual application."},trustedAccessRevokedDescription:{id:"platform.trusted_access.trusted_access.description.revoked",defaultMessage:"Your organization's Daybreak Blue has been revoked.",description:"Body text in the Daybreak Blue detail panel when the organization's prior approval has been revoked. It must clearly distinguish revocation from an inactive status that may be eligible for a new request."},trustedAccessUnavailableDescription:{id:"platform.trusted_access.trusted_access.description.unavailable",defaultMessage:"We can't determine your organization's Daybreak Blue status right now.",description:"Body text in the Daybreak Blue detail panel when the backend cannot determine the organization's status. It must communicate uncertainty and must not imply that access is active or inactive."},statusActive:{id:"platform.trusted_access.state.active",defaultMessage:"Active",description:"Short success-status badge on the Status & access admin page. It means the selected organization-level program is currently effective."},statusRejected:{id:"platform.trusted_access.state.rejected",defaultMessage:"Rejected",description:"Status badge when the organization's current Trusted Access application was rejected, distinct from inactive access or revoked approval."},statusInactive:{id:"platform.trusted_access.state.inactive",defaultMessage:"Inactive",description:"Short neutral-status badge on the Status & access admin page. It means the selected organization-level program is not currently effective."},statusRevoked:{id:"platform.trusted_access.state.revoked",defaultMessage:"Revoked",description:"Short cautionary status badge on the Status & access admin page. It means the organization's prior approval for the selected program is no longer effective and must remain distinct from an inactive requestable state."},statusUnavailable:{id:"platform.trusted_access.state.unavailable",defaultMessage:"Unavailable",description:"Short cautionary status badge on the Status & access admin page. It means the system cannot currently determine whether the selected organization-level program is effective."},organizationAccessTitle:{id:"platform.trusted_access.organization_access.title",defaultMessage:"Organization access",description:"Heading for the access-details card on the Status & access page in Platform organization settings. The card summarizes the selected program's organization-level grant."},accessLevelLabel:{id:"platform.trusted_access.organization_access.level.label",defaultMessage:"Access level",description:"Metadata label in the organization-access card on the Status & access admin page. Its value is a formal program tier such as TAC1, TAC3, or Government."},accessSourceLabel:{id:"platform.trusted_access.organization_access.source.label",defaultMessage:"Source",description:"Metadata label in the organization-access card on the Status & access admin page. Its value explains how the organization received the selected program, such as organization approval."},organizationApproval:{id:"platform.trusted_access.organization_access.source.organization_approval",defaultMessage:"Organization approval",description:"Value next to the Source label in the organization-access card on the Status & access admin page. It means OpenAI approved the organization for the selected program rather than granting an individual user directly."},accessSourceUnavailable:{id:"platform.trusted_access.organization_access.source.unavailable",defaultMessage:"Not available",description:"Value next to the Source label in the organization-access card on the Status & access admin page when there is no active grant or the source cannot be determined. It must not imply that access was approved."},noActiveGrant:{id:"platform.trusted_access.organization_access.level.none",defaultMessage:"No active level",description:"Value next to the Access level label on the Status & access admin page when the selected program has no active organization grant. It must not imply that other unrelated product access is unavailable."},tac1:{id:"platform.trusted_access.organization_access.level.tac1",defaultMessage:"Daybreak Blue",description:"Customer-facing access-level value shown on the Status & access admin page when the backend reports a legacy TAC1 grant. Display the Daybreak Blue brand name instead of the internal tier identifier. Short label with no punctuation."},tac3:{id:"platform.trusted_access.organization_access.level.tac3",defaultMessage:"TAC3",description:"Formal Trusted Access for Cyber tier name shown as an organization access level on the Status & access admin page. Preserve the uppercase letters and number without spaces."},government:{id:"platform.trusted_access.organization_access.level.government",defaultMessage:"Government",description:"Formal Trusted Access for Cyber organization access level shown on the Status & access admin page. This value identifies the Government program tier, not a user role."},memberAccessTitle:{id:"platform.trusted_access.member_access.title",defaultMessage:"Member access",description:"Heading for the member-access card on the Status & access page in Platform organization settings. The card explains whether individual member assignments can be viewed or changed for the selected organization program."},memberAccessOrganizationManaged:{id:"platform.trusted_access.member_access.organization_managed.title",defaultMessage:"Managed at the organization level",description:"Prominent summary in the Member access card when the selected status is inherited from organization approval and this admin surface does not support individual assignments. It should sound factual rather than like an error."},memberAccessOrganizationManagedDescription:{id:"platform.trusted_access.member_access.organization_managed.description",defaultMessage:"This status comes from your organization's approval. Individual member controls aren't available here.",description:"Supporting text in the Member access card when an organization-level status cannot be viewed, granted, or revoked per member. It tells an organization administrator why no member controls are shown and must not imply that a hidden action is available."},memberAccessRevoked:{id:"platform.trusted_access.member_access.revoked.title",defaultMessage:"No member controls available",description:"Prominent summary in the Member access card when the selected organization program has been revoked. It explains why no individual member controls are shown and must not suggest that the program is merely inactive or requestable."},memberAccessRevokedDescription:{id:"platform.trusted_access.member_access.revoked.description",defaultMessage:"Member controls aren't available while this organization status is revoked.",description:"Supporting text in the Member access card when the selected organization program has been revoked. It clearly attributes unavailable member controls to revocation rather than an inactive requestable state."},memberAccessUnavailable:{id:"platform.trusted_access.member_access.unavailable.title",defaultMessage:"Member access can't be determined",description:"Prominent cautionary summary in the Member access card when the selected organization program's status is unavailable. It must not claim that any member has or lacks access."},memberAccessUnavailableDescription:{id:"platform.trusted_access.member_access.unavailable.description",defaultMessage:"Try again later to see whether member access is available for this program.",description:"Supporting text in the Member access card when the selected organization program's status cannot be determined. It asks an organization administrator to return later and does not promise member controls."},businessVerificationTitle:{id:"platform.trusted_access.business_verification.title",defaultMessage:"Business verification",description:"Heading for the persistent organization-level Persona Know Your Business verification section above the trusted-access program tabs in Platform organization settings."},businessVerificationDescription:{id:"platform.trusted_access.business_verification.description",defaultMessage:"Complete verification once to apply for Trusted Access programs.",description:"Supporting text below the organization-level business-verification heading explaining that Persona Know Your Business verification can be reused when applying for trusted-access programs."},businessVerificationVerifiedBadge:{id:"platform.trusted_access.business_verification.status.verified",defaultMessage:"Verified",description:"Success status badge confirming that the selected organization has an approved Persona Know Your Business verification for trusted access."},businessVerificationPendingBadge:{id:"platform.trusted_access.business_verification.status.pending_review",defaultMessage:"Under review",description:"Status badge shown while the selected organization's Persona Know Your Business verification is awaiting a review decision."},businessVerificationDeclinedBadge:{id:"platform.trusted_access.business_verification.status.declined",defaultMessage:"Declined",description:"Status badge shown when the selected organization's Persona Know Your Business verification was declined and a new verification is required."},businessVerificationExpiredBadge:{id:"platform.trusted_access.business_verification.status.expired",defaultMessage:"Expired",description:"Status badge shown when the selected organization's Persona Know Your Business verification expired and needs to be resumed."},businessVerificationVerifiedTitle:{id:"platform.trusted_access.business_verification.verified.title",defaultMessage:"Business verified",description:"Heading in the organization-level business-verification card confirming that Persona approved the selected organization's Know Your Business verification."},businessVerificationVerifiedDescription:{id:"platform.trusted_access.business_verification.verified.description",defaultMessage:"Your organization is verified for Daybreak.",description:"Confirmation that the selected organization's real Persona Know Your Business verification is approved for the Daybreak Trusted Access for Cyber program; preserve the Daybreak product name and uppercase TAC abbreviation."},businessVerificationRequiredBadge:{id:"platform.trusted_access.business_verification.required.badge",defaultMessage:"Business verification required",description:"Short badge on the Platform organization Trusted Access page telling an owner or administrator that the organization's real Persona business verification is required before an inactive organization can request Trusted Access for Cyber or an already-approved organization can satisfy its verification requirement."},businessVerificationRequiredTitle:{id:"platform.trusted_access.business_verification.required.title",defaultMessage:"Complete your business verification",description:"Heading on the Platform organization Trusted Access page asking an owner or administrator to complete the organization's real Persona business verification for Trusted Access for Cyber. The same heading applies to both organizations applying for access and organizations that already have access."},businessVerificationRequiredDescription:{id:"platform.trusted_access.business_verification.required.description",defaultMessage:"Verify your organization with Persona to continue with Daybreak Blue.",description:"Explanatory text on the Platform organization Trusted Access page telling an owner or administrator to complete the organization's real Persona Know Your Business verification for Daybreak Blue. Persona is the identity-verification provider's brand name. The message must not imply that already-approved access has been revoked."},businessVerificationStartAction:{id:"platform.trusted_access.business_verification.required.action.start",defaultMessage:"Start verification for your business",description:"Button on the Platform organization Trusted Access page that creates a real Persona organization Know Your Business inquiry for Trusted Access for Cyber and opens Persona for the authenticated organization administrator. Short action label."},businessVerificationContinueAction:{id:"platform.trusted_access.business_verification.required.action.continue",defaultMessage:"Continue verification for your business",description:"Button on the Platform organization Trusted Access page that opens an existing or resumed Persona organization Know Your Business inquiry for Trusted Access for Cyber. Shown to an organization administrator when verification has started or expired. Short action label."},businessVerificationContinueOnAnotherDeviceAction:{id:"platform.trusted_access.business_verification.required.action.continue_on_another_device",defaultMessage:"Continue on another device",description:"Secondary button on the Platform workspace Trusted Access page that opens a QR-code modal for moving Persona organization Know Your Business verification to a phone or another device. Shown next to the primary Persona verification action for an authenticated organization administrator. Short action label; no placeholders."},businessVerificationRestartAction:{id:"platform.trusted_access.business_verification.required.action.restart",defaultMessage:"Restart verification for your business",description:"Button on the Platform organization Trusted Access page that starts a fresh Persona organization Know Your Business inquiry after an earlier Trusted Access for Cyber business-verification attempt was declined. Short action label for an organization administrator."},businessVerificationPendingReview:{id:"platform.trusted_access.business_verification.required.pending",defaultMessage:"Your verification has been submitted and is awaiting approval.",description:"Read-only progress message on the Platform organization Trusted Access page shown to an owner or administrator when the organization's Persona Know Your Business verification for Trusted Access for Cyber has been submitted and is awaiting a review decision."},handoffPersonaLabel:{id:"platform.trusted_access.business_verification.device_handoff.persona_label",defaultMessage:"Persona",description:"Accessible label for the Persona wordmark in the secure device-handoff modal on the Trusted Access page. Brand name; no placeholders."},handoffPersonaWordmark:{id:"platform.trusted_access.business_verification.device_handoff.persona_wordmark",defaultMessage:"persona*",description:"Visible Persona wordmark in the secure device-handoff modal on the Trusted Access page. Preserve the lowercase brand spelling and trailing asterisk; no placeholders."},handoffTitle:{id:"platform.trusted_access.business_verification.device_handoff.title",defaultMessage:"Continue on another device",description:"Title of the secure device-handoff modal shown on the Trusted Access page after an organization administrator starts Persona business verification. It tells the member that the verification can continue on another device by scanning the QR code. Short modal headline; no placeholders."},handoffDescription:{id:"platform.trusted_access.business_verification.device_handoff.description",defaultMessage:"Scan this QR code to continue business verification on your phone.",description:"Instruction below the title in the secure device-handoff modal on the Trusted Access page. It tells an organization administrator to scan the QR code with a phone to continue the same Persona business-verification flow. Short supporting sentence; no placeholders."},handoffQrCodeLabel:{id:"platform.trusted_access.business_verification.device_handoff.qr_code_label",defaultMessage:"QR code for continuing business verification",description:"Accessible label for the QR code in the secure device-handoff modal on the Trusted Access page. Screen-reader users hear this label for the QR code that opens the same Persona business-verification flow on another device. No placeholders."},handoffCopyLink:{id:"platform.trusted_access.business_verification.device_handoff.copy_link",defaultMessage:"Copy link",description:"Short button label in the secure device-handoff modal on the Trusted Access page. Clicking it copies the Persona business-verification link so an organization administrator can open the same flow on another device. No placeholders."},back:{id:"platform.trusted_access.terms.button.back",defaultMessage:"Back",description:"Secondary button below Daybreak Blue terms in Platform organization settings. Returns to the application checklist without signing. Short label."},copyError:{id:"platform.trusted_access.verification.copy.error",defaultMessage:"We couldn't copy the verification link. Try again.",description:"Error in the Platform organization business-verification handoff modal when copying the Persona link fails. The link remains visible for manual copying."},copied:{id:"platform.trusted_access.verification.copy.success",defaultMessage:"Copied",description:"Short confirmation replacing Copy link after the Persona verification link has been copied in Platform organization settings."},notStarted:{id:"platform.trusted_access.verification.not_started",defaultMessage:"Not started",description:"Short status badge for business verification that has not begun in Platform organization settings."},inProgres