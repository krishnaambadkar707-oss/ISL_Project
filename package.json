{
  "name": "hana-ai-sign-language-companion",
  "private": true,
  "version": "1.0.0",
  "description": "Learn Indian Sign Language (ISL) with Hana, an interactive AI companion featuring voice chat, 2D/3D gesture guides, and real-time camera practice.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/vite/bin/vite.js build",
